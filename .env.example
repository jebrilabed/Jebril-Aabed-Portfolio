# -------------------------------------------------------------
# Google Gemini & AI Assistant Environment Variables
# -------------------------------------------------------------

# Your Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini LLM Model (defaults to gemini-flash-latest)
# Options: gemini-flash-latest, gemini-2.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-flash-latest

# Optional: Google Embedding Model for RAG semantic search (defaults to gemini-embedding-001)
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

